{
  "name": "riddle",
  "displayName": "Riddle",
  "description": "Language support for Riddle",
  "version": "0.3.0",
  "publisher": "riddle-lang",
  "license": "Apache-2.0",
  "icon": "./dist/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/riddle-lang/riddle"
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:riddle",
    "onLanguage:clue",
    "workspaceContains:**/Clue.toml"
  ],
  "main": "./dist/extension.js",
  "files": [
    "dist/extension.js",
    "dist/icon.png",
    "language-configuration.json",
    "syntaxes",
    "icons/riddle.svg",
    "file-icons.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "render-icon": "node scripts/render-icon.mjs",
    "build": "npm run render-icon && esbuild extension.js --bundle --minify --platform=node --external:vscode --outfile=dist/extension.js",
    "check": "node --check extension.js && npm run build",
    "vscode:prepublish": "npm run build"
  },
  "contributes": {
    "languages": [
      {
        "id": "riddle",
        "aliases": [
          "Riddle",
          "riddle"
        ],
        "extensions": [
          ".rid"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "clue",
        "aliases": [
          "Clue",
          "clue"
        ],
        "filenames": [
          "Clue.toml"
        ],
        "configuration": "./clue-language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "riddle",
        "scopeName": "source.riddle",
        "path": "./syntaxes/riddle.tmLanguage.json"
      }
    ],
    "iconThemes": [
      {
        "id": "riddle",
        "label": "Riddle",
        "path": "./file-icons.json"
      }
    ],
    "configuration": {
      "title": "Riddle",
      "properties": {
        "riddle.server.path": {
          "type": "string",
          "default": "riddle-lsp",
          "description": "Path to the riddle-lsp executable."
        },
        "riddle.server.arguments": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Arguments passed to riddle-lsp."
        },
        "riddle.inlayHints.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show inferred types and argument names inline."
        },
        "riddle.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Trace the JSON-RPC traffic between VS Code and riddle-lsp."
        }
      }
    }
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@vscode/vsce": "3.9.2",
    "esbuild": "^0.28.1",
    "vscode-languageclient": "^10.1.0"
  }
}

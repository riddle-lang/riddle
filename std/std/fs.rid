// File access built on the C stdio facade. The runtime provides thin
// `riddle_fs_*` wrappers around `<stdio.h>` so the extern signatures here
// never clash with the platform's own `FILE` typedef. The handle travels as
// `usize`; a null stream compares equal to `0usize`.
use crate::std::result::Result;
use crate::std::string::String;
use crate::std::vector::Vector;

unsafe extern "C" {
    fun riddle_fs_fopen(path: &str, mode: &str) -> usize;
    safe fun riddle_fs_fclose(stream: usize) -> i32;
    safe fun riddle_fs_fread(buffer: *mut u8, size: usize, count: usize, stream: usize) -> usize;
    safe fun riddle_fs_ferror(stream: usize) -> i32;
    safe fun riddle_fs_fwrite(buffer: *const u8, size: usize, count: usize, stream: usize) -> usize;
    safe fun riddle_fs_fflush(stream: usize) -> i32;
}

#[derive(Debug)]
pub enum FsError {
    OpenFailed,
    ReadFailed,
    WriteFailed,
    InvalidData,
}

pub struct FsFile {
    stream: usize,
}

impl FsFile {
    pub fun open(path: &str) -> Result<FsFile, FsError> {
        FsFile::with_mode(path, "r")
    }

    pub fun create(path: &str) -> Result<FsFile, FsError> {
        FsFile::with_mode(path, "w")
    }

    pub fun append(path: &str) -> Result<FsFile, FsError> {
        FsFile::with_mode(path, "a")
    }

    fun with_mode(path: &str, mode: &str) -> Result<FsFile, FsError> {
        let stream = unsafe {
            riddle_fs_fopen(path, mode)
        };
        if stream == 0usize {
            Result::Err(FsError::OpenFailed)
        } else {
            Result::Ok(FsFile {
                stream
            })
        }
    }

    // Reads up to `buffer.len()` bytes; returns how many bytes were read.
    pub fun read(&mut self, buffer: &mut [u8]) -> Result<usize, FsError> {
        if buffer.len() == 0usize {
            return Result::Ok(0usize);
        }
        let ptr = buffer.as_mut_ptr();
        let count = unsafe {
            riddle_fs_fread(ptr, 1usize, buffer.len(), self.stream)
        };
        // A zero count alone cannot distinguish end of stream from a failed
        // read, and reporting the difference is what keeps `read_to_string`
        // from handing back a silently truncated file.
        if count == 0usize && riddle_fs_ferror(self.stream) != 0i32 {
            return Result::Err(FsError::ReadFailed);
        }
        Result::Ok(count)
    }

    pub fun write(&mut self, buffer: &[u8]) -> Result<usize, FsError> {
        if buffer.len() == 0usize {
            return Result::Ok(0usize);
        }
        let ptr = buffer.as_ptr();
        let count = unsafe {
            riddle_fs_fwrite(ptr, 1usize, buffer.len(), self.stream)
        };
        if count == 0usize {
            Result::Err(FsError::WriteFailed)
        } else {
            Result::Ok(count)
        }
    }

    pub fun flush(&mut self) -> Result<(), FsError> {
        let code = unsafe {
            riddle_fs_fflush(self.stream)
        };
        if code == 0i32 {
            Result::Ok(())
        } else {
            Result::Err(FsError::WriteFailed)
        }
    }

    pub fun read_to_string(&mut self) -> Result<String, FsError> {
        let mut bytes: Vector<u8> = Vector::new();
        let mut chunk = [0u8; 1024];
        loop {
            let count = match self.read(&mut chunk) {
                Result::Ok(count) => count,
                Result::Err(err) => {
                    return Result::Err(err);
                },
            };
            if count == 0usize {
                break;
            }
            let mut index = 0usize;
            while index < count {
                bytes.push(chunk[index]);
                index += 1usize;
            }
        }
        // Reject non-UTF-8 files instead of reinterpreting the bytes:
        // `str` guarantees valid UTF-8, and skipping the check would feed
        // invalid data into string slicing and char iteration.
        if !crate::std::string::is_valid_utf8(bytes.as_slice()) {
            return Result::Err(FsError::InvalidData);
        }
        // SAFETY: `&[u8]` and `&str` share layout; the bytes were just
        // validated as UTF-8.
        let text: &str = unsafe {
            bytes.as_slice() as &str
        };
        Result::Ok(String::from_str(text))
    }
}

impl Drop for FsFile {
    fun drop(&mut self) {
        if self.stream != 0usize {
            unsafe {
                riddle_fs_fclose(self.stream)
            };
            self.stream = 0usize;
        }
    }
}

pub fun read_to_string(path: &str) -> Result<String, FsError> {
    let opened = FsFile::open(path);
    let mut file = match opened {
        Result::Ok(value) => value,
        Result::Err(err) => {
            return Result::Err(err);
        },
    };
    file.read_to_string()
}

pub fun write(path: &str, contents: &str) -> Result<(), FsError> {
    let opened = FsFile::create(path);
    let mut file = match opened {
        Result::Ok(value) => value,
        Result::Err(err) => {
            return Result::Err(err);
        },
    };
    let written = file.write(contents.as_bytes());
    match written {
        Result::Ok(_) => {},
        Result::Err(err) => {
            return Result::Err(err);
        },
    }
    file.flush()
}

unsafe extern "C" {
    safe fun riddle_fs_exists(path: &str) -> i32;
    safe fun riddle_fs_remove(path: &str) -> i32;
    safe fun riddle_fs_rename(from: &str, to: &str) -> i32;
    safe fun riddle_fs_size(path: &str) -> u64;
    safe fun riddle_fs_is_file(path: &str) -> i32;
    safe fun riddle_fs_is_dir(path: &str) -> i32;
    safe fun riddle_fs_read_dir(path: &str, names_out: *mut *const u8, lens_out: *mut usize, capacity: usize,) -> usize;
}

#[derive(Debug)]
pub struct FileMetadata {
    pub size: u64,
    pub is_file: bool,
    pub is_dir: bool,
}

pub fun exists(path: &str) -> bool {
    let found = unsafe {
        riddle_fs_exists(path)
    };
    found != 0i32
}

/// Removes the file at `path`. Only regular files are supported; removing a
/// directory reports `FsError::OpenFailed` (the C facade has no distinct
/// directory-removal error).
pub fun remove(path: &str) -> Result<(), FsError> {
    let code = unsafe {
        riddle_fs_remove(path)
    };
    if code == 0i32 {
        Result::Ok(())
    } else {
        Result::Err(FsError::OpenFailed)
    }
}

/// Renames (or moves) the file at `from` to `to`.
pub fun rename(from: &str, to: &str) -> Result<(), FsError> {
    let code = unsafe {
        riddle_fs_rename(from, to)
    };
    if code == 0i32 {
        Result::Ok(())
    } else {
        Result::Err(FsError::OpenFailed)
    }
}

/// Copies the contents of `from` into `to` (truncating `to`), returning the
/// number of bytes copied. The copy is chunked; nothing is buffered whole.
pub fun copy(from: &str, to: &str) -> Result<usize, FsError> {
    let opened_source = FsFile::open(from);
    let mut source = match opened_source {
        Result::Ok(value) => value,
        Result::Err(err) => {
            return Result::Err(err);
        },
    };
    let opened_target = FsFile::create(to);
    let mut target = match opened_target {
        Result::Ok(value) => value,
        Result::Err(err) => {
            return Result::Err(err);
        },
    };
    let mut total = 0usize;
    let mut chunk = [0u8; 4096];
    let mut window: Vector<u8> = Vector::new();
    loop {
        let count = match source.read(&mut chunk) {
            Result::Ok(count) => count,
            Result::Err(err) => {
                return Result::Err(err);
            },
        };
        if count == 0usize {
            break;
        }
        // Build the exact-length view of the chunk. A slice range index does
        // not exist yet, so the partial chunk is gathered into a Vector.
        window.clear();
        let mut index = 0usize;
        while index < count {
            window.push(chunk[index]);
            index += 1usize;
        }
        let written = target.write(window.as_slice())?;
        total += written;
    }
    match target.flush() {
        Result::Ok(()) => Result::Ok(total),
        Result::Err(err) => Result::Err(err),
    }
}

pub fun metadata(path: &str) -> Option<FileMetadata> {
    if !exists(path) {
        return Option::None;
    }
    let size = unsafe {
        riddle_fs_size(path)
    };
    let file_flag = unsafe {
        riddle_fs_is_file(path)
    };
    let dir_flag = unsafe {
        riddle_fs_is_dir(path)
    };
    Option::Some(FileMetadata {
        size,
        is_file: file_flag != 0i32,
        is_dir: dir_flag != 0i32,
    })
}

pub fun read_dir(path: &str) -> Vector<String> {
    let mut capacity = 32usize;
    loop {
        let mut names = Vector::new();
        let mut lens = Vector::new();
        let mut slot = 0usize;
        while slot < capacity {
            names.push(0usize as *const u8);
            lens.push(0usize);
            slot += 1usize;
        }
        let count = unsafe {
            riddle_fs_read_dir(path, names.as_ptr() as *mut *const u8, lens.as_ptr() as *mut usize, capacity,)
        };
        if count > capacity {
            capacity = count + 8usize;
            continue;
        }
        let mut entries = Vector::new();
        let name_base = names.as_ptr();
        let length_base = lens.as_ptr();
        let mut index = 0usize;
        while index < count {
            let pointer: *const u8 = unsafe {
                name_base[index]
            }
            as *const u8;
            let length: usize = unsafe {
                length_base[index]
            };
            let bytes: &[u8] = unsafe {
                (pointer, length) as &[u8]
            };
            entries.push(String::from_utf8(bytes).unwrap_or(String::new()));
            index += 1usize;
        }
        return entries;
    }
}

use crate::std::iter::IntoIterator;
use crate::std::mem::size_of;
use crate::std::panic::panic;
use crate::std::result::Result;
use crate::std::slice::SliceIter;
use crate::std::vector::{
    Vector,
    VectorIntoIter
};

pub enum Delimiter {
    Parenthesis,
    Brace,
    Bracket,
    None,
}

pub enum Spacing {
    Alone,
    Joint,
}

pub struct Span {
    start: usize,
    end: usize,
}

pub struct Group {
    delimiter: Delimiter,
    stream: *mut u8,
    span: Span,
}

pub struct Ident {
    text: Vector<u8>,
    span: Span,
}

pub struct Punct {
    value: char,
    spacing: Spacing,
    span: Span,
}

pub struct Literal {
    text: Vector<u8>,
    span: Span,
}

pub enum TokenTree {
    Group(Group),
    Ident(Ident),
    Punct(Punct),
    Literal(Literal),
}

pub trait ToTokens {
    fun to_tokens(&self, output: &mut TokenStream);
}

pub struct TokenStream {
    data: *mut TokenStreamData,
}

struct TokenStreamData {
    references: usize,
    trees: Vector<TokenTree>,
}

pub struct LexError {
    message: String,
    span: Span,
}

pub struct Diagnostic {
    level: u8,
    message: String,
    span: Span,
}

struct ParsedTokenStream {
    stream: TokenStream,
    closed: bool,
}

struct TokenParser {
    source: &str,
    index: usize,
    span: Span,
    failed: bool,
    error: String,
}

struct ProcWireParser {
    source: &str,
    index: usize,
    failed: bool,
}

unsafe extern "C" {
    safe fun riddle_alloc_bytes(size: usize) -> *mut u8;
    safe fun rgc_free(data: *mut u8);
    safe fun riddle_proc_call_site_start() -> usize;
    safe fun riddle_proc_call_site_end() -> usize;
    safe fun riddle_proc_emit_diagnostic(level: u8, start: usize, end: usize, message: *const u8, len: usize);
    safe fun riddle_proc_set_output(value: *const u8, len: usize);
}

impl crate::std::marker::Copy for Delimiter {}
impl crate::std::marker::Copy for Spacing {}
impl crate::std::marker::Copy for Span {}

impl crate::std::clone::Clone for Group {
    fun clone(&self) -> Group {
        let mut group = Group::new(self.delimiter(), self.stream().clone());
        group.set_span(self.span());
        group
    }
}

impl crate::std::clone::Clone for Ident {
    fun clone(&self) -> Ident {
        Ident::new(self.as_str(), self.span())
    }
}

impl crate::std::clone::Clone for Punct {
    fun clone(&self) -> Punct {
        let mut punct = Punct::new(self.as_char(), self.spacing());
        punct.set_span(self.span());
        punct
    }
}

impl crate::std::clone::Clone for Literal {
    fun clone(&self) -> Literal {
        let mut literal = Literal::new_unchecked(self.as_str());
        literal.set_span(self.span());
        literal
    }
}

impl crate::std::clone::Clone for TokenTree {
    fun clone(&self) -> TokenTree {
        match self {
            TokenTree::Group(value) => TokenTree::Group(value.clone()),
            TokenTree::Ident(value) => TokenTree::Ident(value.clone()),
            TokenTree::Punct(value) => TokenTree::Punct(value.clone()),
            TokenTree::Literal(value) => TokenTree::Literal(value.clone()),
        }
    }
}

impl crate::std::clone::Clone for TokenStream {
    fun clone(&self) -> TokenStream {
        unsafe {
            self.data[0usize].references += 1usize;
        }
        TokenStream {
            data: self.data
        }
    }
}

impl Span {
    fun new(start: usize, end: usize) -> Span {
        Span {
            start,
            end
        }
    }

    pub fun call_site() -> Span {
        Span::new(riddle_proc_call_site_start(), riddle_proc_call_site_end())
    }

    pub fun mixed_site() -> Span {
        Span::call_site()
    }

    pub fun join(&self, other: Span) -> Option<Span> {
        let start = if self.start < other.start {
            self.start
        } else {
            other.start
        };
        let end = if self.end > other.end {
            self.end
        } else {
            other.end
        };
        Option::Some(Span::new(start, end))
    }

    pub fun located_at(&self, other: Span) -> Span {
        Span::new(other.start, other.end)
    }

    pub fun resolved_at(&self, _other: Span) -> Span {
        *self
    }

    pub fun start(&self) -> usize {
        self.start
    }

    pub fun end(&self) -> usize {
        self.end
    }
}

impl Group {
    pub fun new(delimiter: Delimiter, stream: TokenStream) -> Group {
        let mut storage = riddle_alloc_bytes(size_of::<TokenStream>()) as *mut TokenStream;
        unsafe {
            storage[0usize] = stream;
        }
        Group {
            delimiter,
            stream: storage as *mut u8,
            span: Span::call_site(),
        }
    }

    pub fun delimiter(&self) -> Delimiter {
        self.delimiter
    }

    pub fun stream(&self) -> &TokenStream {
        unsafe {
            &(self.stream as *const TokenStream)[0usize]
        }
    }

    pub fun span(&self) -> Span {
        self.span
    }

    pub fun set_span(&mut self, span: Span) {
        self.span = span;
    }
}

impl crate::std::ops::Drop for Group {
    fun drop(&mut self) {
        let stream = unsafe {
            (self.stream as *mut TokenStream)[0usize]
        };
        rgc_free(self.stream);
    }
}

impl Ident {
    pub fun new(value: &str, span: Span) -> Ident {
        if !is_valid_ident(value) {
            panic("Ident::new expected a valid identifier");
        }
        Ident {
            text: copy_text(value),
            span,
        }
    }

    pub fun as_str(&self) -> &str {
        text_as_str(self.text.as_slice())
    }

    pub fun span(&self) -> Span {
        self.span
    }

    pub fun set_span(&mut self, span: Span) {
        self.span = span;
    }
}

impl Punct {
    pub fun new(value: char, spacing: Spacing) -> Punct {
        let code = value as u32;
        if code > 127u32 || !is_punctuation(code as u8) {
            panic("Punct::new expected an ASCII punctuation character");
        }
        Punct {
            value,
            spacing,
            span: Span::call_site(),
        }
    }

    pub fun as_char(&self) -> char {
        self.value
    }

    pub fun spacing(&self) -> Spacing {
        self.spacing
    }

    pub fun span(&self) -> Span {
        self.span
    }

    pub fun set_span(&mut self, span: Span) {
        self.span = span;
    }
}

impl Literal {
    fun new_unchecked(value: &str) -> Literal {
        Literal {
            text: copy_text(value),
            span: Span::call_site(),
        }
    }

    pub fun from_str(value: &str) -> Result<Literal, LexError> {
        match TokenStream::from_str(value) {
            Result::Ok(stream) => {
                if stream.len() != 1usize {
                    return Result::Err(LexError::new("expected exactly one literal", Span::call_site()));
                }
                for tree in stream {
                    match tree {
                        TokenTree::Literal(literal) => {
                            return Result::Ok(literal);
                        },
                        _ => {
                            return Result::Err(LexError::new("expected a literal", Span::call_site()));
                        },
                    }
                }
                Result::Err(LexError::new("expected a literal", Span::call_site()))
            },
            Result::Err(error) => Result::Err(error),
        }
    }

    pub fun string(value: &str) -> Literal {
        let hashes = riddle_proc_literal_hashes(value);
        let mut source = String::new();
        source.push_str("r");
        let mut index = 0usize;
        while index < hashes {
            push_ascii(&mut source, 35u8);
            index += 1usize;
        }
        push_ascii(&mut source, 34u8);
        source.push_str(value);
        push_ascii(&mut source, 34u8);
        index = 0usize;
        while index < hashes {
            push_ascii(&mut source, 35u8);
            index += 1usize;
        }
        Literal::new_unchecked(source.as_str())
    }

    pub fun as_str(&self) -> &str {
        text_as_str(self.text.as_slice())
    }

    pub fun span(&self) -> Span {
        self.span
    }

    pub fun set_span(&mut self, span: Span) {
        self.span = span;
    }
}

impl LexError {
    fun new(message: &str, span: Span) -> LexError {
        LexError {
            message: String::from_str(message),
            span,
        }
    }

    pub fun message(&self) -> &str {
        self.message.as_str()
    }

    pub fun span(&self) -> Span {
        self.span
    }
}

impl TokenTree {
    pub fun cloned(&self) -> TokenTree {
        match self {
            TokenTree::Group(value) => TokenTree::Group(value.clone()),
            TokenTree::Ident(value) => TokenTree::Ident(value.clone()),
            TokenTree::Punct(value) => TokenTree::Punct(value.clone()),
            TokenTree::Literal(value) => TokenTree::Literal(value.clone()),
        }
    }

    pub fun span(&self) -> Span {
        match self {
            TokenTree::Group(value) => value.span(),
            TokenTree::Ident(value) => value.span(),
            TokenTree::Punct(value) => value.span(),
            TokenTree::Literal(value) => value.span(),
        }
    }

    pub fun set_span(&mut self, span: Span) {
        match self {
            TokenTree::Group(value) => value.set_span(span),
            TokenTree::Ident(value) => value.set_span(span),
            TokenTree::Punct(value) => value.set_span(span),
            TokenTree::Literal(value) => value.set_span(span),
        }
    }

    pub fun to_string(&self) -> String {
        let mut output = String::new();
        write_token_tree(self, &mut output);
        output
    }
}

impl ToTokens for TokenStream {
    fun to_tokens(&self, output: &mut TokenStream) {
        output.extend(self.cloned());
    }
}

impl ToTokens for TokenTree {
    fun to_tokens(&self, output: &mut TokenStream) {
        output.push(self.clone());
    }
}

impl ToTokens for Group {
    fun to_tokens(&self, output: &mut TokenStream) {
        output.push(TokenTree::Group(self.clone()));
    }
}

impl ToTokens for Ident {
    fun to_tokens(&self, output: &mut TokenStream) {
        output.push(TokenTree::Ident(self.clone()));
    }
}

impl ToTokens for Punct {
    fun to_tokens(&self, output: &mut TokenStream) {
        output.push(TokenTree::Punct(self.clone()));
    }
}

impl ToTokens for Literal {
    fun to_tokens(&self, output: &mut TokenStream) {
        output.push(TokenTree::Literal(self.clone()));
    }
}

impl ToTokens for String {
    fun to_tokens(&self, output: &mut TokenStream) {
        output.push(TokenTree::Literal(Literal::string(self.as_str())));
    }
}

impl ToTokens for str {
    fun to_tokens(&self, output: &mut TokenStream) {
        output.push(TokenTree::Literal(Literal::string(self)));
    }
}

impl TokenStream {
    fun allocate(trees: Vector<TokenTree>) -> *mut TokenStreamData {
        let mut data = riddle_alloc_bytes(size_of::<TokenStreamData>()) as *mut TokenStreamData;
        unsafe {
            data[0usize] = TokenStreamData {
                references: 1usize,
                trees,
            };
        }
        data
    }

    pub fun new() -> TokenStream {
        TokenStream {
            data: TokenStream::allocate(Vector::new()),
        }
    }

    pub fun cloned(&self) -> TokenStream {
        self.clone()
    }

    pub fun from_str(value: &str) -> Result<TokenStream, LexError> {
        let mut parser = TokenParser::new(value);
        parser.parse()
    }

    pub fun from_tree(tree: TokenTree) -> TokenStream {
        let mut stream = TokenStream::new();
        stream.push(tree);
        stream
    }

    pub fun len(&self) -> usize {
        unsafe {
            self.data[0usize].trees.len()
        }
    }

    pub fun is_empty(&self) -> bool {
        self.len() == 0usize
    }

    pub fun push(&mut self, tree: TokenTree) {
        self.make_unique();
        unsafe {
            self.data[0usize].trees.push(tree);
        }
    }

    pub fun extend(&mut self, stream: TokenStream) {
        for tree in stream {
            self.push(tree);
        }
    }

    pub fun as_slice(&self) -> &[TokenTree] {
        unsafe {
            self.data[0usize].trees.as_slice()
        }
    }

    pub fun to_string(&self) -> String {
        let mut output = String::new();
        write_token_stream(self, &mut output);
        output
    }

    fun make_unique(&mut self) {
        let references = unsafe {
            self.data[0usize].references
        };
        if references == 1usize {
            return;
        }
        let mut trees = Vector::new();
        for tree in self.as_slice() {
            trees.push(tree.clone());
        }
        unsafe {
            self.data[0usize].references -= 1usize;
        }
        self.data = TokenStream::allocate(trees);
    }
}

impl crate::std::ops::Drop for TokenStream {
    fun drop(&mut self) {
        let references = unsafe {
            self.data[0usize].references
        };
        if references > 1usize {
            unsafe {
                self.data[0usize].references -= 1usize;
            }
        } else {
            let allocation = self.data as *mut u8;
            let _owned = unsafe {
                self.data[0usize]
            };
            self.data = 0usize as *mut TokenStreamData;
            rgc_free(allocation);
        }
    }
}

impl IntoIterator for TokenStream {
    type Item = TokenTree;
    type IntoIter = VectorIntoIter<TokenTree>;

    fun into_iter(self) -> Self::IntoIter {
        let mut trees = Vector::new();
        for tree in &self {
            trees.push(tree.clone());
        }
        trees.into_iter()
    }
}

impl IntoIterator for &TokenStream {
    type Item = &TokenTree;
    type IntoIter = SliceIter<TokenTree>;

    fun into_iter(self) -> Self::IntoIter {
        self.as_slice().iter()
    }
}

impl Diagnostic {
    pub fun error(span: Span, message: &str) -> Diagnostic {
        Diagnostic {
            level: 0u8,
            message: String::from_str(message),
            span,
        }
    }

    pub fun warning(span: Span, message: &str) -> Diagnostic {
        Diagnostic {
            level: 1u8,
            message: String::from_str(message),
            span,
        }
    }

    pub fun note(span: Span, message: &str) -> Diagnostic {
        Diagnostic {
            level: 2u8,
            message: String::from_str(message),
            span,
        }
    }

    pub fun help(span: Span, message: &str) -> Diagnostic {
        Diagnostic {
            level: 3u8,
            message: String::from_str(message),
            span,
        }
    }

    pub fun emit(&self) {
        let message = self.message.as_str().as_bytes();
        riddle_proc_emit_diagnostic(self.level, self.span.start(), self.span.end(), message.as_ptr(), message.len());
    }
}

fun riddle_proc_decode_token_stream(input: &str) -> TokenStream {
    let mut parser = ProcWireParser::new(input);
    parser.expect(82u8);
    parser.expect(77u8);
    parser.expect(84u8);
    parser.expect(49u8);
    parser.expect(59u8);
    let stream = parser.parse_stream();
    if parser.failed || parser.index != input.len() {
        Diagnostic::error(Span::call_site(), "invalid structured proc-macro token stream").emit();
        TokenStream::new()
    } else {
        stream
    }
}

impl ProcWireParser {
    fun new(source: &str) -> ProcWireParser {
        ProcWireParser {
            source,
            index: 0usize,
            failed: false,
        }
    }

    fun parse_stream(&mut self) -> TokenStream {
        self.expect(83u8);
        let count = self.read_usize();
        let mut stream = TokenStream::new();
        if count > self.source.len() {
            self.failed = true;
        } else {
            let mut index = 0usize;
            while index < count && !self.failed {
                stream.push(self.parse_tree());
                index += 1usize;
            }
        }
        stream
    }

    fun parse_tree(&mut self) -> TokenTree {
        let tag = self.take();
        if tag == 71u8 {
            let delimiter = match self.read_usize() {
                0usize => Delimiter::Parenthesis,
                1usize => Delimiter::Brace,
                2usize => Delimiter::Bracket,
                3usize => Delimiter::None,
                _ => {
                    self.failed = true;
                    Delimiter::None
                },
            };
            let span = self.read_span();
            let stream = self.parse_stream();
            let mut group = Group::new(delimiter, stream);
            group.set_span(span);
            return TokenTree::Group(group);
        }
        if tag == 73u8 {
            let span = self.read_span();
            let text = self.read_text();
            return TokenTree::Ident(Ident {
                text,
                span
            });
        }
        if tag == 76u8 {
            let span = self.read_span();
            let text = self.read_text();
            return TokenTree::Literal(Literal {
                text,
                span
            });
        }
        if tag == 80u8 {
            let span = self.read_span();
            let spacing = match self.read_usize() {
                0usize => Spacing::Alone,
                1usize => Spacing::Joint,
                _ => {
                    self.failed = true;
                    Spacing::Alone
                },
            };
            let value = self.read_usize();
            if value > 127usize {
                self.failed = true;
            }
            return TokenTree::Punct(Punct {
                value: value as u8 as char,
                spacing,
                span,
            });
        }
        self.failed = true;
        TokenTree::Ident(Ident {
            text: Vector::new(),
            span: Span::call_site(),
        })
    }

    fun read_span(&mut self) -> Span {
        let start = self.read_usize();
        let end = self.read_usize();
        if start > end {
            self.failed = true;
        }
        Span::new(start, end)
    }

    fun read_text(&mut self) -> Vector<u8> {
        let len = self.read_usize();
        let mut text = Vector::new();
        if len > (self.source.len() - self.index) / 2usize {
            self.failed = true;
        } else {
            let mut index = 0usize;
            while index < len && !self.failed {
                let high = self.read_hex();
                let low = self.read_hex();
                text.push((high << 4u8) | low);
                index += 1usize;
            }
        }
        text
    }

    fun read_hex(&mut self) -> u8 {
        let value = self.take();
        if value >= 48u8 && value <= 57u8 {
            return value - 48u8;
        }
        if value >= 97u8 && value <= 102u8 {
            return value - 97u8 + 10u8;
        }
        if value >= 65u8 && value <= 70u8 {
            return value - 65u8 + 10u8;
        }
        self.failed = true;
        0u8
    }

    fun read_usize(&mut self) -> usize {
        let mut value = 0usize;
        let mut saw_digit = false;
        while !self.failed {
            let byte = self.take();
            if byte == 59u8 {
                if !saw_digit {
                    self.failed = true;
                }
                return value;
            }
            if byte < 48u8 || byte > 57u8 {
                self.failed = true;
                return 0usize;
            }
            saw_digit = true;
            let digit = (byte - 48u8) as usize;
            if value > 429496729usize || (value == 429496729usize && digit > 5usize) {
                self.failed = true;
                return 0usize;
            }
            value = value * 10usize + digit;
        }
        0usize
    }

    fun expect(&mut self, expected: u8) {
        if self.take() != expected {
            self.failed = true;
        }
    }

    fun take(&mut self) -> u8 {
        match self.source.as_bytes().get(self.index) {
            Some(value) => {
                self.index += 1usize;
                *value
            },
            None => {
                self.failed = true;
                0u8
            },
        }
    }
}

impl TokenParser {
    fun new(source: &str) -> TokenParser {
        TokenParser {
            source,
            index: 0usize,
            span: Span::call_site(),
            failed: false,
            error: String::new(),
        }
    }

    fun parse(&mut self) -> Result<TokenStream, LexError> {
        let parsed = self.parse_until(0u8);
        if self.failed {
            Result::Err(LexError::new(self.error.as_str(), self.span))
        } else {
            Result::Ok(parsed.stream)
        }
    }

    fun parse_until(&mut self, closing: u8) -> ParsedTokenStream {
        let mut stream = TokenStream::new();
        let mut closed = closing == 0u8;
        while self.index < self.source.len() {
            let byte = self.byte_at(self.index);
            if closing != 0u8 && byte == closing {
                self.index += 1usize;
                closed = true;
                break;
            }
            if is_closing_delimiter(byte) {
                self.fail("unexpected closing delimiter");
                break;
            }
            if is_whitespace(byte) {
                self.index += 1usize;
                continue;
            }
            if byte == 47u8 && self.peek(1usize, 47u8) {
                self.skip_line_comment();
                continue;
            }
            if byte == 47u8 && self.peek(1usize, 42u8) {
                self.skip_block_comment();
                continue;
            }
            if byte == 40u8 {
                self.parse_group(&mut stream, Delimiter::Parenthesis, 41u8, byte);
                continue;
            }
            if byte == 123u8 {
                self.parse_group(&mut stream, Delimiter::Brace, 125u8, byte);
                continue;
            }
            if byte == 91u8 {
                self.parse_group(&mut stream, Delimiter::Bracket, 93u8, byte);
                continue;
            }
            match self.raw_string_hashes() {
                Option::Some(hashes) => {
                    stream.push(TokenTree::Literal(self.scan_raw_literal(hashes)));
                    continue;
                },
                Option::None => {},
            }
            if byte == 34u8 || byte == 39u8 {
                stream.push(TokenTree::Literal(self.scan_quoted_literal(byte)));
                continue;
            }
            if is_digit(byte) {
                stream.push(TokenTree::Literal(self.scan_number()));
                continue;
            }
            if is_ident_start(byte) {
                stream.push(TokenTree::Ident(self.scan_ident()));
                continue;
            }
            if !is_punctuation(byte) {
                self.fail("invalid character in token stream");
                break;
            }
            stream.push(TokenTree::Punct(self.scan_punct()));
        }
        ParsedTokenStream {
            stream,
            closed,
        }
    }

    fun parse_group(&mut self, output: &mut TokenStream, delimiter: Delimiter, closing: u8, opening: u8) {
        let start = self.index;
        self.index += 1usize;
        let parsed = self.parse_until(closing);
        match parsed {
            ParsedTokenStream {
                stream: inner,
                closed: true
            }
            => {
                let mut group = Group::new(delimiter, inner);
                group.set_span(self.span);
                output.push(TokenTree::Group(group));
            },
            ParsedTokenStream {
                stream: inner,
                closed: false
            }
            => {
                let _opening = opening;
                let _inner = inner;
                self.fail("unclosed delimiter");
            },
        }
    }

    fun skip_line_comment(&mut self) {
        self.index += 2usize;
        while self.index < self.source.len() && self.byte_at(self.index) != 10u8 {
            self.index += 1usize;
        }
    }

    fun skip_block_comment(&mut self) {
        self.index += 2usize;
        let mut depth = 1usize;
        while self.index < self.source.len() && depth > 0usize {
            if self.byte_at(self.index) == 47u8 && self.peek(1usize, 42u8) {
                depth += 1usize;
                self.index += 2usize;
            } else if self.byte_at(self.index) == 42u8 && self.peek(1usize, 47u8) {
                depth -= 1usize;
                self.index += 2usize;
            } else {
                self.index += 1usize;
            }
        }
        if depth != 0usize {
            self.fail("unclosed block comment");
        }
    }

    fun raw_string_hashes(&self) -> Option<usize> {
        if self.byte_at(self.index) != 114u8 {
            return Option::None;
        }
        let mut cursor = self.index + 1usize;
        let mut hashes = 0usize;
        while cursor < self.source.len() && self.byte_at(cursor) == 35u8 {
            hashes += 1usize;
            cursor += 1usize;
        }
        if cursor < self.source.len() && self.byte_at(cursor) == 34u8 {
            Option::Some(hashes)
        } else {
            Option::None
        }
    }

    fun scan_raw_literal(&mut self, hashes: usize) -> Literal {
        let start = self.index;
        let mut cursor = self.index + 2usize + hashes;
        while cursor < self.source.len() {
            if self.byte_at(cursor) == 34u8 {
                let mut tail = cursor + 1usize;
                let mut matched = 0usize;
                while matched < hashes && tail < self.source.len() && self.byte_at(tail) == 35u8 {
                    matched += 1usize;
                    tail += 1usize;
                }
                if matched == hashes {
                    self.index = tail;
                    return self.literal_between(start, self.index);
                }
            }
            cursor += 1usize;
        }
        self.index = self.source.len();
        self.fail("unclosed raw string literal");
        self.literal_between(start, self.index)
    }

    fun scan_quoted_literal(&mut self, quote: u8) -> Literal {
        let start = self.index;
        self.index += 1usize;
        let mut escaped = false;
        let mut closed = false;
        while self.index < self.source.len() {
            let byte = self.byte_at(self.index);
            self.index += 1usize;
            if escaped {
                escaped = false;
            } else if byte == 92u8 {
                escaped = true;
            } else if byte == quote {
                closed = true;
                break;
            }
        }
        if !closed {
            self.fail("unclosed quoted literal");
        }
        self.literal_between(start, self.index)
    }

    fun scan_number(&mut self) -> Literal {
        let start = self.index;
        while self.index < self.source.len() && is_digit(self.byte_at(self.index)) {
            self.index += 1usize;
        }
        if self.index < self.source.len() && self.byte_at(self.index) == 46u8 {
            self.index += 1usize;
            while self.index < self.source.len() && is_digit(self.byte_at(self.index)) {
                self.index += 1usize;
            }
        }
        if self.index < self.source.len() && (self.byte_at(self.index) == 101u8 || self.byte_at(self.index) == 69u8) {
            let mut cursor = self.index + 1usize;
            if cursor < self.source.len() && (self.byte_at(cursor) == 43u8 || self.byte_at(cursor) == 45u8) {
                cursor += 1usize;
            }
            let digits = cursor;
            while cursor < self.source.len() && is_digit(self.byte_at(cursor)) {
                cursor += 1usize;
            }
            if cursor > digits {
                self.index = cursor;
            }
        }
        while self.index < self.source.len() && (is_ident_continue(self.byte_at(self.index))) {
            self.index += 1usize;
        }
        self.literal_between(start, self.index)
    }

    fun scan_ident(&mut self) -> Ident {
        let start = self.index;
        self.index += 1usize;
        while self.index < self.source.len() && is_ident_continue(self.byte_at(self.index)) {
            self.index += 1usize;
        }
        let text = self.text_between(start, self.index);
        Ident {
            text,
            span: self.span,
        }
    }

    fun scan_punct(&mut self) -> Punct {
        let start = self.index;
        let byte = self.byte_at(self.index);
        self.index += 1usize;
        let spacing = if self.next_is_joint_punctuation() {
            Spacing::Joint
        } else {
            Spacing::Alone
        };
        let mut punct = Punct::new(byte as char, spacing);
        punct.set_span(self.span);
        punct
    }

    fun literal_between(&self, start: usize, end: usize) -> Literal {
        Literal {
            text: self.text_between(start, end),
            span: self.span,
        }
    }

    fun text_between(&self, start: usize, end: usize) -> Vector<u8> {
        let mut text = Vector::new();
        let mut index = start;
        while index < end {
            text.push(self.byte_at(index));
            index += 1usize;
        }
        text
    }

    fun peek(&self, offset: usize, expected: u8) -> bool {
        let index = self.index + offset;
        index < self.source.len() && self.byte_at(index) == expected
    }

    fun next_is_joint_punctuation(&self) -> bool {
        if self.index >= self.source.len() || !is_punctuation(self.byte_at(self.index)) {
            return false;
        }
        self.byte_at(self.index) != 47u8 || !self.peek(1usize, 47u8)
    }

    fun byte_at(&self, index: usize) -> u8 {
        unsafe {
            self.source.as_bytes().as_ptr()[index]
        }
    }

    fun fail(&mut self, message: &str) {
        if !self.failed {
            self.failed = true;
            self.error = String::from_str(message);
        }
    }
}

fun is_whitespace(value: u8) -> bool {
    value == 32u8 || value == 9u8 || value == 10u8 || value == 13u8
}

fun is_digit(value: u8) -> bool {
    value >= 48u8 && value <= 57u8
}

fun is_ident_start(value: u8) -> bool {
    (value >= 65u8 && value <= 90u8) || (value >= 97u8 && value <= 122u8) || value == 95u8
}

fun is_ident_continue(value: u8) -> bool {
    is_ident_start(value) || is_digit(value)
}

fun is_punctuation(value: u8) -> bool {
    value == 43u8 || value == 45u8 || value == 42u8 || value == 47u8 || value == 37u8 || value == 38u8 || value == 124u8 || value == 94u8 || value == 60u8 || value == 62u8 || value == 33u8 || value == 63u8 || value == 35u8 || value == 46u8 || value == 58u8 || value == 59u8 || value == 44u8 || value == 61u8
}

fun is_closing_delimiter(value: u8) -> bool {
    value == 41u8 || value == 93u8 || value == 125u8
}

fun is_valid_ident(value: &str) -> bool {
    if value.is_empty() || !is_ident_start(value.as_bytes()[0usize]) {
        return false;
    }
    let mut index = 1usize;
    while index < value.len() {
        if !is_ident_continue(value.as_bytes()[index]) {
            return false;
        }
        index += 1usize;
    }
    true
}

fun copy_text(value: &str) -> Vector<u8> {
    let mut text = Vector::new();
    for byte in value.as_bytes() {
        text.push(*byte);
    }
    text
}

fun text_as_str(value: &[u8]) -> &str {
    unsafe {
        value as &str
    }
}

fun riddle_proc_literal_hashes(value: &str) -> usize {
    let bytes = value.as_bytes();
    let mut required = 0usize;
    let mut index = 0usize;
    while index < bytes.len() {
        if bytes[index] == 34u8 {
            let mut hashes = 0usize;
            index += 1usize;
            while index < bytes.len() && bytes[index] == 35u8 {
                hashes += 1usize;
                index += 1usize;
            }
            if hashes >= required {
                required = hashes + 1usize;
            }
        } else {
            index += 1usize;
        }
    }
    required
}

fun write_token_stream(stream: &TokenStream, output: &mut String) {
    let mut first = true;
    let mut joint = false;
    for tree in stream {
        if !first && !joint {
            output.push_str(" ");
        }
        write_token_tree(tree, output);
        joint = match tree {
            TokenTree::Punct(value) => match value.spacing() {
                Spacing::Joint => true,
                Spacing::Alone => false,
            },
            _ => false,
        };
        first = false;
    }
}

fun write_token_tree(tree: &TokenTree, output: &mut String) {
    match tree {
        TokenTree::Group(value) => {
            match value.delimiter() {
                Delimiter::Parenthesis => push_ascii(output, 40u8),
                Delimiter::Brace => push_ascii(output, 123u8),
                Delimiter::Bracket => push_ascii(output, 91u8),
                Delimiter::None => {},
            }
            write_token_stream(value.stream(), output);
            match value.delimiter() {
                Delimiter::Parenthesis => push_ascii(output, 41u8),
                Delimiter::Brace => push_ascii(output, 125u8),
                Delimiter::Bracket => push_ascii(output, 93u8),
                Delimiter::None => {},
            }
        },
        TokenTree::Ident(value) => output.push_str(value.as_str()),
        TokenTree::Punct(value) => push_ascii(output, value.as_char() as u8),
        TokenTree::Literal(value) => output.push_str(value.as_str()),
    }
}

fun push_ascii(output: &mut String, value: u8) {
    let bytes = [value];
    let slice: &[u8] = &bytes;
    let text = unsafe {
        slice as &str
    };
    output.push_str(text);
}

pub fun emit_output(value: &TokenStream) {
    let mut output = String::from_str("RMT1;");
    riddle_proc_wire_write_stream(value, &mut output);
    let bytes = output.as_str().as_bytes();
    riddle_proc_set_output(bytes.as_ptr(), bytes.len());
}

fun riddle_proc_wire_write_stream(value: &TokenStream, output: &mut String) {
    push_ascii(output, 83u8);
    riddle_proc_wire_write_field(output, value.len());
    for tree in value {
        riddle_proc_wire_write_tree(tree, output);
    }
}

fun riddle_proc_wire_write_tree(value: &TokenTree, output: &mut String) {
    match value {
        TokenTree::Group(group) => {
            push_ascii(output, 71u8);
            let delimiter = match group.delimiter() {
                Delimiter::Parenthesis => 0usize,
                Delimiter::Brace => 1usize,
                Delimiter::Bracket => 2usize,
                Delimiter::None => 3usize,
            };
            riddle_proc_wire_write_field(output, delimiter);
            riddle_proc_wire_write_span(output, group.span());
            riddle_proc_wire_write_stream(group.stream(), output);
        },
        TokenTree::Ident(ident) => {
            push_ascii(output, 73u8);
            riddle_proc_wire_write_text(output, ident.span(), ident.as_str());
        },
        TokenTree::Punct(punct) => {
            push_ascii(output, 80u8);
            riddle_proc_wire_write_span(output, punct.span());
            let spacing = match punct.spacing() {
                Spacing::Alone => 0usize,
                Spacing::Joint => 1usize,
            };
            riddle_proc_wire_write_field(output, spacing);
            riddle_proc_wire_write_field(output, punct.as_char() as u32 as usize);
        },
        TokenTree::Literal(literal) => {
            push_ascii(output, 76u8);
            riddle_proc_wire_write_text(output, literal.span(), literal.as_str());
        },
    }
}

fun riddle_proc_wire_write_span(output: &mut String, span: Span) {
    riddle_proc_wire_write_field(output, span.start());
    riddle_proc_wire_write_field(output, span.end());
}

fun riddle_proc_wire_write_text(output: &mut String, span: Span, value: &str) {
    riddle_proc_wire_write_span(output, span);
    riddle_proc_wire_write_field(output, value.len());
    for byte in value.as_bytes() {
        riddle_proc_wire_write_hex(output, *byte >> 4u8);
        riddle_proc_wire_write_hex(output, *byte & 15u8);
    }
}

fun riddle_proc_wire_write_hex(output: &mut String, value: u8) {
    if value < 10u8 {
        push_ascii(output, value + 48u8);
    } else {
        push_ascii(output, value - 10u8 + 97u8);
    }
}

fun riddle_proc_wire_write_field(output: &mut String, value: usize) {
    riddle_proc_wire_write_usize(output, value);
    push_ascii(output, 59u8);
}

fun riddle_proc_wire_write_usize(output: &mut String, value: usize) {
    if value >= 10usize {
        riddle_proc_wire_write_usize(output, value / 10usize);
    }
    push_ascii(output, (value % 10usize) as u8 + 48u8);
}

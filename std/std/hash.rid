pub trait Hash {
    fun hash(&self) -> usize;
}

impl Hash for bool {
    fun hash(&self) -> usize {
        if *self {
            1usize
        } else {
            0usize
        }
    }
}
impl Hash for char {
    fun hash(&self) -> usize {
        *self as usize
    }
}
impl Hash for i8 {
    fun hash(&self) -> usize {
        *self as usize
    }
}
impl Hash for i16 {
    fun hash(&self) -> usize {
        *self as usize
    }
}
impl Hash for i32 {
    fun hash(&self) -> usize {
        *self as usize
    }
}
impl Hash for i64 {
    fun hash(&self) -> usize {
        *self as usize
    }
}
impl Hash for isize {
    fun hash(&self) -> usize {
        *self as usize
    }
}
impl Hash for u8 {
    fun hash(&self) -> usize {
        *self as usize
    }
}
impl Hash for u16 {
    fun hash(&self) -> usize {
        *self as usize
    }
}
impl Hash for u32 {
    fun hash(&self) -> usize {
        *self as usize
    }
}
impl Hash for u64 {
    fun hash(&self) -> usize {
        *self as usize
    }
}
impl Hash for usize {
    fun hash(&self) -> usize {
        *self
    }
}

// String keys arrive as `&str` slices, so `&str` needs its own impl; without
// it `HashMap<&str, V>` fails the `Hash` bound at the call site. The fold is
// the same FNV-1a `String` uses, so both spellings of the same text hash
// alike.
impl Hash for &str {
    fun hash(&self) -> usize {
        let text: &str = *self;
        let mut value = 1469598103934665603u64;
        for byte in text.as_bytes() {
            value = (value ^ (*byte as u64)) * 1099511628211u64;
        }
        value as usize
    }
}

// Floats hash their bit pattern: a value cast (`as`) would truncate instead
// of reinterpreting, collapsing every fraction below 1.0 onto the same hash.
// `-0.0` and `0.0` compare equal yet hash apart, which is safe only because
// `f32`/`f64` implement `PartialEq` but not `Eq` — a `HashMap` key needs
// `Hash + Eq`, so no float can be a key today. Revisit if `Eq for f64` ever
// lands: canonicalize negative zero here first.
impl Hash for f32 {
    fun hash(&self) -> usize {
        mix64(f32_bits(*self) as u64) as usize
    }
}
impl Hash for f64 {
    fun hash(&self) -> usize {
        mix64(f64_bits(*self)) as usize
    }
}

// The bytes are read through a `&[u8]` view rather than by casting the pointer
// to `*const u32` / `*const u64`: dereferencing a `float`/`double` object
// through an integer pointer is strict-aliasing UB and `-O2` is free to fold
// such a read away, while unsigned-character access to any object's
// representation is always defined. The fold is little-endian, which reproduces
// the value's bits exactly on the supported targets.
fun f32_bits(value: f32) -> u32 {
    let values = [value];
    let source: &[f32] = &values;
    // SAFETY: `bytes` spans 4 of the 4 bytes of the live one-element array
    // above, and `&[u8]` may alias any object.
    let bytes: &[u8] = unsafe {
        (source.as_ptr() as *const u8, 4usize) as &[u8]
    };
    bytes_to_u64(bytes) as u32
}

fun f64_bits(value: f64) -> u64 {
    let values = [value];
    let source: &[f64] = &values;
    // SAFETY: `bytes` spans 8 of the 8 bytes of the live one-element array
    // above, and `&[u8]` may alias any object.
    let bytes: &[u8] = unsafe {
        (source.as_ptr() as *const u8, 8usize) as &[u8]
    };
    bytes_to_u64(bytes)
}

// Fold a byte view into an integer, least-significant byte first.
fun bytes_to_u64(bytes: &[u8]) -> u64 {
    let mut bits = 0u64;
    let mut index = 0usize;
    while index < bytes.len() {
        bits = bits | ((bytes[index] as u64) << (index * 8usize));
        index += 1usize;
    }
    bits
}

// MurmurHash3 `fmix64` finalizer: spreads consecutive bit patterns across the
// whole 64-bit range so table bucket indices (hash % count) stay well
// distributed.
fun mix64(value: u64) -> u64 {
    let mut mixed = value;
    mixed = mixed ^ (mixed >> 33usize);
    mixed = mixed * 0xff51afd7ed558ccdu64;
    mixed = mixed ^ (mixed >> 33usize);
    mixed = mixed * 0xc4ceb9fe1a85ec53u64;
    mixed = mixed ^ (mixed >> 33usize);
    mixed
}

// ── Tuple hashing ───────────────────────────────────────────────────────────
// Folds each element's hash through the `mix64` finalizer so field order
// matters and consecutive keys spread across buckets.

impl<A, B> Hash for (A, B) where A: Hash, B: Hash {
    fun hash(&self) -> usize {
        let mut acc = self.0.hash() as u64;
        acc = mix64(acc ^ mix64(self.1.hash() as u64));
        acc as usize
    }
}

impl<A, B, C> Hash for (A, B, C) where A: Hash, B: Hash, C: Hash {
    fun hash(&self) -> usize {
        let mut acc = self.0.hash() as u64;
        acc = mix64(acc ^ mix64(self.1.hash() as u64));
        acc = mix64(acc ^ mix64(self.2.hash() as u64));
        acc as usize
    }
}

impl<A, B, C, D> Hash for (A, B, C, D) where A: Hash, B: Hash, C: Hash, D: Hash {
    fun hash(&self) -> usize {
        let mut acc = self.0.hash() as u64;
        acc = mix64(acc ^ mix64(self.1.hash() as u64));
        acc = mix64(acc ^ mix64(self.2.hash() as u64));
        acc = mix64(acc ^ mix64(self.3.hash() as u64));
        acc as usize
    }
}

impl<A, B, C, D, E> Hash for (A, B, C, D, E) where A: Hash, B: Hash, C: Hash, D: Hash, E: Hash {
    fun hash(&self) -> usize {
        let mut acc = self.0.hash() as u64;
        acc = mix64(acc ^ mix64(self.1.hash() as u64));
        acc = mix64(acc ^ mix64(self.2.hash() as u64));
        acc = mix64(acc ^ mix64(self.3.hash() as u64));
        acc = mix64(acc ^ mix64(self.4.hash() as u64));
        acc as usize
    }
}

impl<A, B, C, D, E, F> Hash for (A, B, C, D, E, F) where A: Hash, B: Hash, C: Hash, D: Hash, E: Hash, F: Hash {
    fun hash(&self) -> usize {
        let mut acc = self.0.hash() as u64;
        acc = mix64(acc ^ mix64(self.1.hash() as u64));
        acc = mix64(acc ^ mix64(self.2.hash() as u64));
        acc = mix64(acc ^ mix64(self.3.hash() as u64));
        acc = mix64(acc ^ mix64(self.4.hash() as u64));
        acc = mix64(acc ^ mix64(self.5.hash() as u64));
        acc as usize
    }
}
